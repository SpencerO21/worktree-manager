{
  "name": "spencers-worktree-manager",
  "displayName": "TreeHugger - Worktree Manager",
  "description": "See, create, and open Git worktrees in dedicated VS Code windows.",
  "version": "1.0.0",
  "publisher": "spencer021",
  "icon": "media/treehugger.png",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpencerO21/worktree-manager.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeManager",
          "title": "TreeHugger",
          "icon": "media/worktree.svg"
        }
      ]
    },
    "views": {
      "worktreeManager": [
        {
          "id": "worktreeManager.tree",
          "name": "Worktrees",
          "icon": "media/worktree.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "worktreeManager.tree",
        "when": "!worktreeManager.allRepositories && !worktreeManager.hasWorktreeFilter",
        "contents": "No git worktrees found for the folder open in this window.\n\nOpen a folder that lives in a git repository, or widen the view to every repository under `worktreeManager.searchPaths`.\n\n[New Worktree](command:worktreeManager.createWorktree)\n[Show All Repositories](command:worktreeManager.showAllRepositories)\n[Refresh](command:worktreeManager.refresh)"
      },
      {
        "view": "worktreeManager.tree",
        "when": "worktreeManager.allRepositories && !worktreeManager.hasWorktreeFilter",
        "contents": "No git worktrees found.\n\nTreeHugger is looking in your open folders and in the paths listed under the `worktreeManager.searchPaths` setting.\n\n[New Worktree](command:worktreeManager.createWorktree)\n[Open Settings](command:worktreeManager.openSettings)\n[Refresh](command:worktreeManager.refresh)"
      },
      {
        "view": "worktreeManager.tree",
        "when": "worktreeManager.hasWorktreeFilter",
        "contents": "No worktrees match the active filter.\n\n[Clear Filter](command:worktreeManager.clearWorktreeFilter)\n[Choose Filter](command:worktreeManager.filterWorktrees)"
      }
    ],
    "commands": [
      {
        "command": "worktreeManager.createWorktree",
        "title": "New Worktree",
        "category": "Worktrees",
        "icon": "$(add)"
      },
      {
        "command": "worktreeManager.startTask",
        "title": "Start Task in New Worktree",
        "category": "Worktrees",
        "icon": "$(sparkle)"
      },
      {
        "command": "worktreeManager.switchWorktree",
        "title": "Switch Worktree",
        "category": "Worktrees",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "worktreeManager.openTerminal",
        "title": "Open Terminal",
        "category": "Worktrees",
        "icon": "$(terminal)"
      },
      {
        "command": "worktreeManager.runWorktree",
        "title": "Run App",
        "category": "Worktrees",
        "icon": "$(play)"
      },
      {
        "command": "worktreeManager.revealApp",
        "title": "Reveal App Terminal",
        "category": "Worktrees",
        "icon": "$(terminal)"
      },
      {
        "command": "worktreeManager.restartApp",
        "title": "Restart App",
        "category": "Worktrees",
        "icon": "$(debug-restart)"
      },
      {
        "command": "worktreeManager.stopApp",
        "title": "Stop App",
        "category": "Worktrees",
        "icon": "$(debug-stop)"
      },
      {
        "command": "worktreeManager.setupWorktree",
        "title": "Setup Worktree",
        "category": "Worktrees",
        "icon": "$(tools)"
      },
      {
        "command": "worktreeManager.removeWorktree",
        "title": "Remove Worktree",
        "category": "Worktrees",
        "icon": "$(trash)"
      },
      {
        "command": "worktreeManager.pruneWorktrees",
        "title": "Remove Missing Worktrees",
        "category": "Worktrees",
        "icon": "$(clear-all)"
      },
      {
        "command": "worktreeManager.refresh",
        "title": "Refresh",
        "category": "Worktrees",
        "icon": "$(refresh)"
      },
      {
        "command": "worktreeManager.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "Worktrees",
        "icon": "$(output)"
      },
      {
        "command": "worktreeManager.filterWorktrees",
        "title": "Filter Worktrees",
        "category": "Worktrees",
        "icon": "$(filter)"
      },
      {
        "command": "worktreeManager.clearWorktreeFilter",
        "title": "Clear Worktree Filter",
        "category": "Worktrees",
        "icon": "$(filter-filled)"
      },
      {
        "command": "worktreeManager.togglePinned",
        "title": "Toggle Pin",
        "category": "Worktrees",
        "icon": "$(pin)"
      },
      {
        "command": "worktreeManager.showAllRepositories",
        "title": "Show Worktrees From All Repositories",
        "category": "Worktrees",
        "icon": "$(globe)"
      },
      {
        "command": "worktreeManager.showThisRepository",
        "title": "Show Only This Repository's Worktrees",
        "category": "Worktrees",
        "icon": "$(filter-filled)"
      },
      {
        "command": "worktreeManager.openWorktree",
        "title": "Switch to Worktree",
        "category": "Worktrees",
        "icon": "$(folder-opened)"
      },
      {
        "command": "worktreeManager.openWorktreeCurrentWindow",
        "title": "Open in This Window",
        "category": "Worktrees",
        "icon": "$(window)"
      },
      {
        "command": "worktreeManager.openWorktreeNewWindow",
        "title": "Open in New Window",
        "category": "Worktrees",
        "icon": "$(empty-window)"
      },
      {
        "command": "worktreeManager.resumeSession",
        "title": "Open Worktree and Resume Chat",
        "category": "Worktrees",
        "icon": "$(debug-continue)"
      },
      {
        "command": "worktreeManager.newClaudeSession",
        "title": "Start Claude Code Here",
        "category": "Worktrees",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "worktreeManager.newCodexSession",
        "title": "Start Codex Here",
        "category": "Worktrees",
        "icon": "$(terminal)"
      },
      {
        "command": "worktreeManager.focusAgent",
        "title": "Focus Active Agent",
        "category": "Worktrees",
        "icon": "$(terminal)"
      },
      {
        "command": "worktreeManager.stopAgent",
        "title": "Stop Active Agent",
        "category": "Worktrees",
        "icon": "$(debug-stop)"
      },
      {
        "command": "worktreeManager.openService",
        "title": "Open Service",
        "category": "Worktrees",
        "icon": "$(link-external)"
      },
      {
        "command": "worktreeManager.revealInOS",
        "title": "Reveal in Finder",
        "category": "Worktrees"
      },
      {
        "command": "worktreeManager.revealInSourceControl",
        "title": "Reveal in Source Control",
        "category": "Worktrees"
      },
      {
        "command": "worktreeManager.migrateWorktreeChanges",
        "title": "Migrate Worktree Changes with VS Code",
        "category": "Worktrees"
      },
      {
        "command": "worktreeManager.copyPath",
        "title": "Copy Path",
        "category": "Worktrees"
      },
      {
        "command": "worktreeManager.openSettings",
        "title": "Open TreeHugger Settings",
        "category": "Worktrees"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "worktreeManager.openWorktreeCurrentWindow",
          "when": "false"
        },
        {
          "command": "worktreeManager.resumeSession",
          "when": "false"
        },
        {
          "command": "worktreeManager.openService",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "worktreeManager.startTask",
          "when": "view == worktreeManager.tree",
          "group": "navigation@0"
        },
        {
          "command": "worktreeManager.createWorktree",
          "when": "view == worktreeManager.tree",
          "group": "navigation@1"
        },
        {
          "command": "worktreeManager.showAllRepositories",
          "when": "view == worktreeManager.tree && !worktreeManager.allRepositories",
          "group": "navigation@2"
        },
        {
          "command": "worktreeManager.showThisRepository",
          "when": "view == worktreeManager.tree && worktreeManager.allRepositories",
          "group": "navigation@2"
        },
        {
          "command": "worktreeManager.pruneWorktrees",
          "when": "view == worktreeManager.tree && worktreeManager.hasMissingWorktrees",
          "group": "navigation@3"
        },
        {
          "command": "worktreeManager.filterWorktrees",
          "when": "view == worktreeManager.tree && !worktreeManager.hasWorktreeFilter",
          "group": "navigation@3"
        },
        {
          "command": "worktreeManager.clearWorktreeFilter",
          "when": "view == worktreeManager.tree && worktreeManager.hasWorktreeFilter",
          "group": "navigation@3"
        },
        {
          "command": "worktreeManager.refresh",
          "when": "view == worktreeManager.tree",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "worktreeManager.togglePinned",
          "when": "view == worktreeManager.tree && (viewItem =~ /^worktree/ || viewItem == repository)",
          "group": "3_misc@0"
        },
        {
          "command": "worktreeManager.openWorktreeNewWindow",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "inline@1"
        },
        {
          "command": "worktreeManager.openWorktreeNewWindow",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "1_open@1"
        },
        {
          "command": "worktreeManager.openWorktreeCurrentWindow",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "1_open@2"
        },
        {
          "command": "worktreeManager.runWorktree",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "inline@2"
        },
        {
          "command": "worktreeManager.runWorktree",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "2_new@1"
        },
        {
          "command": "worktreeManager.revealApp",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "2_new@1.1"
        },
        {
          "command": "worktreeManager.restartApp",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "2_new@1.2"
        },
        {
          "command": "worktreeManager.stopApp",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "2_new@1.3"
        },
        {
          "command": "worktreeManager.setupWorktree",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "2_new@2"
        },
        {
          "command": "worktreeManager.openTerminal",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "2_new@3"
        },
        {
          "command": "worktreeManager.newClaudeSession",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "2_new@4"
        },
        {
          "command": "worktreeManager.newCodexSession",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "2_new@5"
        },
        {
          "command": "worktreeManager.revealInOS",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "3_misc@1"
        },
        {
          "command": "worktreeManager.revealInSourceControl",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "3_misc@2"
        },
        {
          "command": "worktreeManager.migrateWorktreeChanges",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "3_misc@3"
        },
        {
          "command": "worktreeManager.copyPath",
          "when": "view == worktreeManager.tree && viewItem =~ /^worktree/",
          "group": "3_misc@4"
        },
        {
          "command": "worktreeManager.removeWorktree",
          "when": "view == worktreeManager.tree && viewItem == worktree",
          "group": "9_danger@1"
        },
        {
          "command": "worktreeManager.removeWorktree",
          "when": "view == worktreeManager.tree && viewItem == missing-worktree",
          "group": "inline@1"
        },
        {
          "command": "worktreeManager.removeWorktree",
          "when": "view == worktreeManager.tree && viewItem == missing-worktree",
          "group": "9_danger@1"
        },
        {
          "command": "worktreeManager.copyPath",
          "when": "view == worktreeManager.tree && viewItem == missing-worktree",
          "group": "3_misc@2"
        },
        {
          "command": "worktreeManager.pruneWorktrees",
          "when": "view == worktreeManager.tree && viewItem == missing-worktree",
          "group": "9_danger@2"
        },
        {
          "command": "worktreeManager.resumeSession",
          "when": "view == worktreeManager.tree && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "worktreeManager.openService",
          "when": "view == worktreeManager.tree && viewItem == worktree-service",
          "group": "inline@1"
        },
        {
          "command": "worktreeManager.focusAgent",
          "when": "view == worktreeManager.tree && viewItem == active-agent",
          "group": "inline@1"
        },
        {
          "command": "worktreeManager.stopAgent",
          "when": "view == worktreeManager.tree && viewItem == active-agent",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "TreeHugger - Worktree Manager",
      "properties": {
        "worktreeManager.scope": {
          "type": "string",
          "enum": [
            "currentRepository",
            "searchPaths"
          ],
          "enumDescriptions": [
            "Only the worktrees belonging to the repository open in this window.",
            "Every worktree found under worktreeManager.searchPaths, plus those of the open folders."
          ],
          "default": "currentRepository",
          "description": "Which worktrees the view lists. Switch between the two from the button in the view title."
        },
        "worktreeManager.searchPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/projects"
          ],
          "markdownDescription": "Directories scanned for git repositories when `#worktreeManager.scope#` is `searchPaths`. Each entry is scanned one level deep, so `~/projects` picks up `~/projects/my-repo`. `~` is expanded."
        },
        "worktreeManager.revealViewOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Bring the Worktrees view back up once the window has reloaded into the worktree you switched to."
        },
        "worktreeManager.newWorktreePath": {
          "type": "string",
          "default": "~/projects/{repoName}-{branch}",
          "markdownDescription": "Default directory for worktrees created from the view. Keeping every worktree under one parent means VS Code's workspace trust only has to be granted for that parent once. Supports `{repoPath}`, `{repoParent}`, `{repoName}` and `{branch}` (slashes in the branch become dashes), and `~`. The resolved path is always shown for editing before the worktree is created."
        },
        "worktreeManager.pruneMissingWorktrees": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run `git worktree prune` when the view finds a worktree whose directory no longer exists, so deleting a worktree's folder by hand also takes it out of the list. Turn this off to keep those rows visible — they are marked `missing` and can be cleared from the row's trash button — if your worktrees live on removable or network storage that is not always mounted. Locked worktrees are never pruned."
        },
        "worktreeManager.filter": {
          "type": "string",
          "enum": [
            "all",
            "open",
            "dirty",
            "running",
            "missing",
            "stale"
          ],
          "default": "all",
          "description": "Limit the tree to worktrees matching one operational state. Use the filter button in the view title to change this quickly."
        },
        "worktreeManager.sortBy": {
          "type": "string",
          "enum": [
            "name",
            "recentActivity",
            "status"
          ],
          "enumDescriptions": [
            "Sort by worktree directory name.",
            "Sort by most recent commit.",
            "Show missing, failed, running, and dirty worktrees first."
          ],
          "default": "name",
          "description": "How worktrees are sorted within each repository. Pinned worktrees always come first."
        },
        "worktreeManager.showSessions": {
          "type": "boolean",
          "default": true,
          "description": "Show the Claude Code and Codex chats associated with each worktree as expandable children."
        },
        "worktreeManager.maxSessionsPerWorktree": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "How many recent chats to list under each worktree."
        },
        "worktreeManager.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to launch Claude Code."
        },
        "worktreeManager.codexCommand": {
          "type": "string",
          "default": "codex",
          "description": "Command used to launch Codex."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit",
    "pretest": "tsc -p . && node esbuild.js",
    "test": "node ./out/test/runTests.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.0",
    "mocha": "^11.8.0",
    "typescript": "^5.6.0"
  }
}
